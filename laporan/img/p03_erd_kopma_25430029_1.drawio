itas = maksimum, simbol lebih jauh = minimum. Label angka di ujung garis: 1 = tepat satu, 0..1 = nol atau satu, 1..N = satu atau banyak, 0..N = nol atau banyak.&lt;br/&gt;PK = kunci primer | FK = kunci tamu | PK, FK = kunci primer komposit | AK = kunci alternatif | &lt;i&gt;/atribut&lt;/i&gt; = atribut turunan (dihitung)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;fillColor=#F7F9FC;strokeColor=#8896AB;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="930" width="1270" height="110" as="geometry"/></mxCell><mxCell id="c27" value="Hamid Indra Nugroho | 25430029 | Kelas B" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F3A5F;fontStyle=1;fontColor=#1F3A5F;fontSize=12;" vertex="1" parent="1"><mxGeometry x="940" y="1094" width="380" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>