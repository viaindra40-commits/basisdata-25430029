        </mxCell>
        <mxCell id="yNCI66VUZA5SIGW3lZlW-1499" parent="1" style="rounded=0;html=1;align=left;verticalAlign=top;spacing=14;fontSize=15;fillColor=#F7F8FC;strokeColor=#8A99B5;strokeWidth=2;whiteSpace=wrap;" value="&lt;b&gt;Keterangan&lt;/b&gt;&lt;br&gt;Simbol di ujung garis: || tepat satu (1); o| nol atau satu (0..1); |&amp;lt; satu atau banyak (1..N); o&amp;lt; nol atau banyak (0..N).&lt;br&gt;PK = kunci primer; FK = kunci tamu; PK, FK = kunci primer komposit yang juga kunci tamu; AK = kunci alternatif.&lt;br&gt;/atribut (miring) = atribut turunan, dihitung dan tidak disimpan. Label angka di ujung garis = batas minimum..maksimum. Batas maksimum 5 eksemplar per transaksi (AB-04) dijaga logika transaksi, tidak digambar sebagai label." vertex="1">
          <mxGeometry height="150" width="1980" x="2370.7656543337894" y="2671.697641378586" as="geometry" />
        </mxCell>
