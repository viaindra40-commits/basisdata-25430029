  penerimaan:R_id_penerimaan:e -> detail_penerimaan:L_id_penerimaan:w [arrowtail=teetee, arrowhead=crowodot];
  buku:R_id_buku:e -> detail_penerimaan:L_id_buku:w [arrowtail=teetee, arrowhead=crowodot];
  legend [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555" BGCOLOR="#FAFAFA"><TR><TD ALIGN="LEFT" COLSPAN="2"><B>Keterangan</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#B00020" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">kunci primer (nama tebal; PK,FK = bagian kunci komposit sekaligus kunci tamu)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1B5E9B" POINT-SIZE="9"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">kunci tamu (nama miring), ditulis dengan tabel tujuannya (→ tabel)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6A1B9A" POINT-SIZE="9"><B>UQ</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUE (tidak boleh kembar)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FDE8E8"><FONT COLOR="#B00020" POINT-SIZE="9"><B>[PD]</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">data pribadi (kolom diberi latar merah muda)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9"><B>CK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">CHECK constraint (nama mengikuti pola ck_ + tabel)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">⊢ ⋖</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">garis relasi: induk (satu, | |) → anak (banyak, kaki gagak); lingkaran = boleh kosong</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="9"><B>ON DELETE:</B> seluruh kunci tamu memakai aksi bawaan RESTRICT (galat 1451),</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="9">sehingga tidak ada aksi yang ditulis pada kolom FK.  Nilai turunan tidak disimpan.</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="9"><B>Warna judul:</B> <FONT COLOR="#2F5D8C">■ master</FONT>  <FONT COLOR="#2E7D5B">■ kepala transaksi</FONT>  <FONT COLOR="#B8641E">■ detail transaksi</FONT>  <FONT COLOR="#6B6B6B">■ asosiatif</FONT></FONT></TD></TR></TABLE>>];
}
