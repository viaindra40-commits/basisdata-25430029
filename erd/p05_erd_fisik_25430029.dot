digraph ERD {
  graph [rankdir=LR, bgcolor="white", fontname="DejaVu Sans", nodesep=0.45, ranksep=1.2, pad=0.4, splines=true, labelloc=t, labeljust=l,
    label=<<FONT POINT-SIZE="22"><B>ERD Fisik perpus_029 – Sistem Perpustakaan</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="12" COLOR="#444444">Hamid Indra Nugroho · NIM 25430029 · Kelas B · Praktikum Basis Data, Modul 5 (Pertemuan 05) · MariaDB 10.4.32 · 12 tabel · 14 kunci tamu</FONT><BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>>];
  node [shape=plain, fontname="DejaVu Sans"];
  edge [color="#4A4A4A", penwidth=1.2, arrowsize=0.9, dir=both];
  petugas [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#555555" BGCOLOR="white"><TR><TD COLSPAN="4" BGCOLOR="#2F5D8C" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="13"><B> petugas</B></FONT>  <FONT COLOR="#E8E8E8" POINT-SIZE="9">master</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_id_petugas"><FONT COLOR="#B00020" POINT-SIZE="8"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><B>id_petugas</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">SMALLINT</FONT></TD><TD ALIGN="LEFT" PORT="R_id_petugas"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · AUTO_INCREMENT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_nomor_petugas"><FONT COLOR="#6A1B9A" POINT-SIZE="8"><B>UQ</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">nomor_petugas</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">CHAR(5)</FONT></TD><TD ALIGN="LEFT" PORT="R_nomor_petugas"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · UNIQUE</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_nama_petugas"><FONT COLOR="#000000" POINT-SIZE="8"><B>&nbsp;&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">nama_petugas</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">VARCHAR(100)</FONT></TD><TD ALIGN="LEFT" PORT="R_nama_petugas"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_alamat_petugas" BGCOLOR="#FDE8E8"><FONT COLOR="#000000" POINT-SIZE="8"><B>&nbsp;&nbsp;</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FDE8E8"><FONT POINT-SIZE="10">alamat_petugas</FONT> <FONT COLOR="#B00020" POINT-SIZE="8"><B>[PD]</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FDE8E8"><FONT POINT-SIZE="9" COLOR="#333333">VARCHAR(255)</FONT></TD><TD ALIGN="LEFT" PORT="R_alamat_petugas" BGCOLOR="#FDE8E8"><FONT POINT-SIZE="8" COLOR="#555555">NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_no_hp_petugas" BGCOLOR="#FDE8E8"><FONT COLOR="#000000" POINT-SIZE="8"><B>&nbsp;&nbsp;</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FDE8E8"><FONT POINT-SIZE="10">no_hp_petugas</FONT> <FONT COLOR="#B00020" POINT-SIZE="8"><B>[PD]</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FDE8E8"><FONT POINT-SIZE="9" COLOR="#333333">VARCHAR(15)</FONT></TD><TD ALIGN="LEFT" PORT="R_no_hp_petugas" BGCOLOR="#FDE8E8"><FONT POINT-SIZE="8" COLOR="#555555">NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_peran_petugas"><FONT COLOR="#000000" POINT-SIZE="8"><B>&nbsp;&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">peran_petugas</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">ENUM('Petugas','Kepala')</FONT></TD><TD ALIGN="LEFT" PORT="R_peran_petugas"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL</FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#F3F3F3" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#333333">CK ck_petugas_nomor: format nomor petugas</FONT></TD></TR></TABLE>>];
  anggota [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#555555" BGCOLOR="white"><TR><TD COLSPAN="4" BGCOLOR="#2F5D8C" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="13"><B> anggota</B></FONT>  <FONT COLOR="#E8E8E8" POINT-SIZE="9">master</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_id_anggota"><FONT COLOR="#B00020" POINT-SIZE="8"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><B>id_anggota</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">INT(11)</FONT></TD><TD ALIGN="LEFT" PORT="R_id_anggota"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · AUTO_INCREMENT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_nomor_anggota"><FONT COLOR="#6A1B9A" POINT-SIZE="8"><B>UQ</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">nomor_anggota</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">CHAR(7)</FONT></TD><TD ALIGN="LEFT" PORT="R_nomor_anggota"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · UNIQUE</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_nim_anggota"><FONT COLOR="#6A1B9A" POINT-SIZE="8"><B>UQ</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">nim_anggota</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">CHAR(8)</FONT></TD><TD ALIGN="LEFT" PORT="R_nim_anggota"><FONT POINT-SIZE="8" COLOR="#555555">NULL · UNIQUE</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_nidn_anggota"><FONT COLOR="#6A1B9A" POINT-SIZE="8"><B>UQ</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">nidn_anggota</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">CHAR(10)</FONT></TD><TD ALIGN="LEFT" PORT="R_nidn_anggota"><FONT POINT-SIZE="8" COLOR="#555555">NULL · UNIQUE</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_nama_anggota"><FONT COLOR="#000000" POINT-SIZE="8"><B>&nbsp;&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">nama_anggota</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">VARCHAR(100)</FONT></TD><TD ALIGN="LEFT" PORT="R_nama_anggota"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_jenis_anggota"><FONT COLOR="#000000" POINT-SIZE="8"><B>&nbsp;&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">jenis_anggota</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">ENUM('Mahasiswa','Dosen')</FONT></TD><TD ALIGN="LEFT" PORT="R_jenis_anggota"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_prodi_unit_anggota"><FONT COLOR="#000000" POINT-SIZE="8"><B>&nbsp;&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">prodi_unit_anggota</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">VARCHAR(100)</FONT></TD><TD ALIGN="LEFT" PORT="R_prodi_unit_anggota"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_no_hp_anggota" BGCOLOR="#FDE8E8"><FONT COLOR="#000000" POINT-SIZE="8"><B>&nbsp;&nbsp;</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FDE8E8"><FONT POINT-SIZE="10">no_hp_anggota</FONT> <FONT COLOR="#B00020" POINT-SIZE="8"><B>[PD]</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FDE8E8"><FONT POINT-SIZE="9" COLOR="#333333">VARCHAR(15)</FONT></TD><TD ALIGN="LEFT" PORT="R_no_hp_anggota" BGCOLOR="#FDE8E8"><FONT POINT-SIZE="8" COLOR="#555555">NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_alamat_anggota" BGCOLOR="#FDE8E8"><FONT COLOR="#000000" POINT-SIZE="8"><B>&nbsp;&nbsp;</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FDE8E8"><FONT POINT-SIZE="10">alamat_anggota</FONT> <FONT COLOR="#B00020" POINT-SIZE="8"><B>[PD]</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FDE8E8"><FONT POINT-SIZE="9" COLOR="#333333">VARCHAR(255)</FONT></TD><TD ALIGN="LEFT" PORT="R_alamat_anggota" BGCOLOR="#FDE8E8"><FONT POINT-SIZE="8" COLOR="#555555">NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_tanggal_daftar_anggota"><FONT COLOR="#000000" POINT-SIZE="8"><B>&nbsp;&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">tanggal_daftar_anggota</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">DATE</FONT></TD><TD ALIGN="LEFT" PORT="R_tanggal_daftar_anggota"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_status_anggota"><FONT COLOR="#000000" POINT-SIZE="8"><B>&nbsp;&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">status_anggota</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">ENUM('Aktif','Ditangguhkan','Nonaktif')</FONT></TD><TD ALIGN="LEFT" PORT="R_status_anggota"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · DEFAULT 'Aktif'</FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#F3F3F3" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#333333">CK ck_anggota_nomor: ^AG-[0-9]{4}$</FONT><BR/><FONT POINT-SIZE="8" COLOR="#333333">CK ck_anggota_nim: NULL atau 8 digit</FONT><BR/><FONT POINT-SIZE="8" COLOR="#333333">CK ck_anggota_nidn: NULL atau 10 digit</FONT><BR/><FONT POINT-SIZE="8" COLOR="#333333">CK ck_anggota_identitas: Mahasiswa → NIM wajib, NIDN kosong;</FONT><BR/><FONT POINT-SIZE="8" COLOR="#333333">      Dosen → NIDN wajib, NIM kosong</FONT></TD></TR></TABLE>>];
  buku [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#555555" BGCOLOR="white"><TR><TD COLSPAN="4" BGCOLOR="#2F5D8C" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="13"><B> buku</B></FONT>  <FONT COLOR="#E8E8E8" POINT-SIZE="9">master</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_id_buku"><FONT COLOR="#B00020" POINT-SIZE="8"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><B>id_buku</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">INT(11)</FONT></TD><TD ALIGN="LEFT" PORT="R_id_buku"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · AUTO_INCREMENT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_kode_buku"><FONT COLOR="#6A1B9A" POINT-SIZE="8"><B>UQ</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">kode_buku</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">CHAR(7)</FONT></TD><TD ALIGN="LEFT" PORT="R_kode_buku"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · UNIQUE</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_isbn_buku"><FONT COLOR="#6A1B9A" POINT-SIZE="8"><B>UQ</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">isbn_buku</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">CHAR(13)</FONT></TD><TD ALIGN="LEFT" PORT="R_isbn_buku"><FONT POINT-SIZE="8" COLOR="#555555">NULL · UNIQUE</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_judul_buku"><FONT COLOR="#000000" POINT-SIZE="8"><B>&nbsp;&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">judul_buku</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">VARCHAR(200)</FONT></TD><TD ALIGN="LEFT" PORT="R_judul_buku"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_penerbit_buku"><FONT COLOR="#000000" POINT-SIZE="8"><B>&nbsp;&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">penerbit_buku</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">VARCHAR(100)</FONT></TD><TD ALIGN="LEFT" PORT="R_penerbit_buku"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_tahun_terbit_buku"><FONT COLOR="#000000" POINT-SIZE="8"><B>&nbsp;&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">tahun_terbit_buku</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">SMALLINT(6)</FONT></TD><TD ALIGN="LEFT" PORT="R_tahun_terbit_buku"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_kategori_buku"><FONT COLOR="#000000" POINT-SIZE="8"><B>&nbsp;&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">kategori_buku</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">VARCHAR(50)</FONT></TD><TD ALIGN="LEFT" PORT="R_kategori_buku"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL</FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#F3F3F3" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#333333">CK ck_buku_kode: format kode buku</FONT><BR/><FONT POINT-SIZE="8" COLOR="#333333">CK ck_buku_isbn: NULL atau 13 digit</FONT><BR/><FONT POINT-SIZE="8" COLOR="#333333">CK ck_buku_tahun: rentang tahun terbit</FONT></TD></TR></TABLE>>];
  eksemplar [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#555555" BGCOLOR="white"><TR><TD COLSPAN="4" BGCOLOR="#2F5D8C" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="13"><B> eksemplar</B></FONT>  <FONT COLOR="#E8E8E8" POINT-SIZE="9">master</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_id_eksemplar"><FONT COLOR="#B00020" POINT-SIZE="8"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><B>id_eksemplar</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">INT(11)</FONT></TD><TD ALIGN="LEFT" PORT="R_id_eksemplar"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · AUTO_INCREMENT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_no_eksemplar"><FONT COLOR="#6A1B9A" POINT-SIZE="8"><B>UQ</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">no_eksemplar</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">CHAR(10)</FONT></TD><TD ALIGN="LEFT" PORT="R_no_eksemplar"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · UNIQUE</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_kondisi_eksemplar"><FONT COLOR="#000000" POINT-SIZE="8"><B>&nbsp;&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">kondisi_eksemplar</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">ENUM('Baik','Rusak ringan','Rusak berat')</FONT></TD><TD ALIGN="LEFT" PORT="R_kondisi_eksemplar"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · DEFAULT 'Baik'</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_status_eksemplar"><FONT COLOR="#000000" POINT-SIZE="8"><B>&nbsp;&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">status_eksemplar</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">ENUM('Tersedia','Dipinjam','Diperbaiki','Hilang')</FONT></TD><TD ALIGN="LEFT" PORT="R_status_eksemplar"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · DEFAULT 'Tersedia'</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_tanggal_masuk_eksemplar"><FONT COLOR="#000000" POINT-SIZE="8"><B>&nbsp;&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">ta