  pemasok [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#555555" BGCOLOR="white"><TR><TD COLSPAN="4" BGCOLOR="#2F5D8C" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="13"><B> pemasok</B></FONT>  <FONT COLOR="#E8E8E8" POINT-SIZE="9">master</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_id_pemasok"><FONT COLOR="#B00020" POINT-SIZE="8"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><B>id_pemasok</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">SMALLINT</FONT></TD><TD ALIGN="LEFT" PORT="R_id_pemasok"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · AUTO_INCREMENT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_kode_pemasok"><FONT COLOR="#6A1B9A" POINT-SIZE="8"><B>UQ</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">kode_pemasok</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">CHAR(6)</FONT></TD><TD ALIGN="LEFT" PORT="R_kode_pemasok"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · UNIQUE</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_nama_pemasok"><FONT COLOR="#000000" POINT-SIZE="8"><B>&nbsp;&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">nama_pemasok</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">VARCHAR(100)</FONT></TD><TD ALIGN="LEFT" PORT="R_nama_pemasok"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_alamat_pemasok"><FONT COLOR="#000000" POINT-SIZE="8"><B>&nbsp;&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">alamat_pemasok</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">VARCHAR(255)</FONT></TD><TD ALIGN="LEFT" PORT="R_alamat_pemasok"><FONT POINT-SIZE="8" COLOR="#555555">NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_telepon_pemasok"><FONT COLOR="#000000" POINT-SIZE="8"><B>&nbsp;&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">telepon_pemasok</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">VARCHAR(15)</FONT></TD><TD ALIGN="LEFT" PORT="R_telepon_pemasok"><FONT POINT-SIZE="8" COLOR="#555555">NULL</FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#F3F3F3" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#333333">CK ck_pemasok_kode: format kode pemasok</FONT></TD></TR></TABLE>>];
  peminjaman [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#555555" BGCOLOR="white"><TR><TD COLSPAN="4" BGCOLOR="#2E7D5B" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="13"><B> peminjaman</B></FONT>  <FONT COLOR="#E8E8E8" POINT-SIZE="9">kepala transaksi</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_id_peminjaman"><FONT COLOR="#B00020" POINT-SIZE="8"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><B>id_peminjaman</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">INT(11)</FONT></TD><TD ALIGN="LEFT" PORT="R_id_peminjaman"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · AUTO_INCREMENT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_nomor_peminjaman"><FONT COLOR="#6A1B9A" POINT-SIZE="8"><B>UQ</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">nomor_peminjaman</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">CHAR(13)</FONT></TD><TD ALIGN="LEFT" PORT="R_nomor_peminjaman"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · UNIQUE</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_tanggal_pinjam_peminjaman"><FONT COLOR="#000000" POINT-SIZE="8"><B>&nbsp;&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">tanggal_pinjam_peminjaman</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">DATE</FONT></TD><TD ALIGN="LEFT" PORT="R_tanggal_pinjam_peminjaman"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_tanggal_jatuh_tempo_peminjaman"><FONT COLOR="#000000" POINT-SIZE="8"><B>&nbsp;&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">tanggal_jatuh_tempo_peminjaman</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">DATE</FONT></TD><TD ALIGN="LEFT" PORT="R_tanggal_jatuh_tempo_peminjaman"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_status_peminjaman"><FONT COLOR="#000000" POINT-SIZE="8"><B>&nbsp;&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">status_peminjaman</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">ENUM('Berjalan','Selesai','Dibatalkan')</FONT></TD><TD ALIGN="LEFT" PORT="R_status_peminjaman"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · DEFAULT 'Berjalan'</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_id_anggota"><FONT COLOR="#1B5E9B" POINT-SIZE="8"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><I>id_anggota</I></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">INT(11)</FONT></TD><TD ALIGN="LEFT" PORT="R_id_anggota"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · FK → anggota</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_id_petugas"><FONT COLOR="#1B5E9B" POINT-SIZE="8"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><I>id_petugas</I></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">SMALLINT</FONT></TD><TD ALIGN="LEFT" PORT="R_id_petugas"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · FK → petugas</FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#F3F3F3" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#333333">CK ck_peminjaman_nomor: ^PJM-[0-9]{4}-[0-9]{4}$</FONT><BR/><FONT POINT-SIZE="8" COLOR="#333333">CK ck_peminjaman_tempo: jatuh tempo ≥ tanggal pinjam</FONT></TD></TR></TABLE>>];
  detail_peminjaman [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#555555" BGCOLOR="white"><TR><TD COLSPAN="4" BGCOLOR="#B8641E" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="13"><B> detail_peminjaman</B></FONT>  <FONT COLOR="#E8E8E8" POINT-SIZE="9">detail transaksi</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_id_peminjaman"><FONT COLOR="#B00020" POINT-SIZE="8"><B>PK,FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><B>id_peminjaman</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">INT(11)</FONT></TD><TD ALIGN="LEFT" PORT="R_id_peminjaman"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · FK → peminjaman</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_id_eksemplar"><FONT COLOR="#B00020" POINT-SIZE="8"><B>PK,FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><B>id_eksemplar</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">INT(11)</FONT></TD><TD ALIGN="LEFT" PORT="R_id_eksemplar"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · FK → eksemplar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_tanggal_kembali_detail_peminjaman"><FONT COLOR="#000000" POINT-SIZE="8"><B>&nbsp;&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">tanggal_kembali_detail_peminjaman</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">DATE</FONT></TD><TD ALIGN="LEFT" PORT="R_tanggal_kembali_detail_peminjaman"><FONT POINT-SIZE="8" COLOR="#555555">NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_kondisi_kembali_detail_peminjaman"><FONT COLOR="#000000" POINT-SIZE="8"><B>&nbsp;&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">kondisi_kembali_detail_peminjaman</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">ENUM('Baik','Rusak ringan','Rusak berat')</FONT></TD><TD ALIGN="LEFT" PORT="R_kondisi_kembali_detail_peminjaman"><FONT POINT-SIZE="8" COLOR="#555555">NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_catatan_pemeriksaan_detail_peminjaman"><FONT COLOR="#000000" POINT-SIZE="8"><B>&nbsp;&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">catatan_pemeriksaan_detail_peminjaman</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">VARCHAR(255)</FONT></TD><TD ALIGN="LEFT" PORT="R_catatan_pemeriksaan_detail_peminjaman"><FONT POINT-SIZE="8" COLOR="#555555">NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_id_petugas_kembali"><FONT COLOR="#1B5E9B" POINT-SIZE="8"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><I>id_petugas_kembali</I></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">SMALLINT</FONT></TD><TD ALIGN="LEFT" PORT="R_id_petugas_kembali"><FONT POINT-SIZE="8" COLOR="#555555">NULL · FK → petugas</FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#F3F3F3" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#333333">CK ck_detail_peminjaman_kembali: tanggal, kondisi, dan petugas</FONT><BR/><FONT POINT-SIZE="8" COLOR="#333333">      kembali terisi semua atau kosong semua</FONT></TD></TR></TABLE>>];
  sanksi [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#555555" BGCOLOR="white"><TR><TD COLSPAN="4" BGCOLOR="#B8641E" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="13"><B> sanksi</B></FONT>  <FONT COLOR="#E8E8E8" POINT-SIZE="9">detail transaksi</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_id_sanksi"><FONT COLOR="#B00020" POINT-SIZE="8"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><B>id_sanksi</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">INT(11)</FONT></TD><TD ALIGN="LEFT" PORT="R_id_sanksi"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · AUTO_INCREMENT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_nomor_sanksi"><FONT COLOR="#6A1B9A" POINT-SIZE="8"><B>UQ</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">nomor_sanksi</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">CHAR(11)</FONT></TD><TD ALIGN="LEFT" PORT="R_nomor_sanksi"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · UNIQUE</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_jenis_sanksi"><FONT COLOR="#000000" POINT-SIZE="8"><B>&nbsp;&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">jenis_sanksi</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">ENUM('Denda','Ganti buku','Skorsing')</FONT></TD><TD ALIGN="LEFT" PORT="R_jenis_sanksi"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_nominal_sanksi"><FONT COLOR="#000000" POINT-SIZE="8"><B>&nbsp;&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">nominal_sanksi</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">DECIMAL(12,2)</FONT></TD><TD ALIGN="LEFT" PORT="R_nominal_sanksi"><FONT POINT-SIZE="8" COLOR="#555555">NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_tanggal_sanksi"><FONT COLOR="#000000" POINT-SIZE="8"><B>&nbsp;&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">tanggal_sanksi</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">DATE</FONT></TD><TD ALIGN="LEFT" PORT="R_tanggal_sanksi"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_status_lunas_sanksi"><FONT COLOR="#000000" POINT-SIZE="8"><B>&nbsp;&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">status_lunas_sanksi</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">ENUM('Ya','Belum')</FONT></TD><TD ALIGN="LEFT" PORT="R_status_lunas_sanksi"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · DEFAULT 'Belum'</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_tanggal_lunas_sanksi"><FONT COLOR="#000000" POINT-SIZE="8"><B>&nbsp;&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">tanggal_lunas_sanksi</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">DATE</FONT></TD><TD ALIGN="LEFT" PORT="R_tanggal_lunas_sanksi"><FONT POINT-SIZE="8" COLOR="#555555">NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_id_peminjaman"><FONT COLOR="#1B5E9B" POINT-SIZE="8"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><I>id_peminjaman</I></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">INT(11)</FONT></TD><TD ALIGN="LEFT" PORT="R_id_peminjaman"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · FK → detail_peminjaman (komposit)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_id_eksemplar"><FONT COLOR="#1B5E9B" POINT-SIZE="8"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><I>id_eksemplar</I></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">INT(11)</FONT></TD><TD ALIGN="LEFT" PORT="R_id_eksemplar"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · FK → detail_peminjaman (komposit)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_id_petugas"><FONT COLOR="#1B5E9B" POINT-SIZE="8"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><I>id_petugas</I></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">SMALLINT</FONT></TD><TD ALIGN="LEFT" PORT="R_id_petugas"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · FK → petugas</FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#F3F3F3" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#333333">CK ck_sanksi_nomor: ^SK-[0-9]{4}-[0-9]{3}$</FONT><BR/><FONT POINT-SIZE="8" COLOR="#333333">CK ck_sanksi_nominal: NULL atau ≥ 0</FONT><BR/><FONT POINT-SIZE="8" COLOR="#333333">CK ck_sanksi_denda: jenis Denda → nominal wajib</FONT><BR/><FONT POINT-SIZE="8" COLOR="#333333">CK ck_sanksi_lunas: lunas 'Ya' ⇔ tanggal lunas terisi</FONT><BR/><FONT POINT-SIZE="8" COLOR="#333333">CK ck_sanksi_tgl_lunas: tanggal lunas ≥ tanggal sanksi</FONT></TD></TR></TABLE>>];
  penerimaan [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#555555" BGCOLOR="white"><TR><TD COLSPAN="4" BGCOLOR="#2E7D5B" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="13"><B> penerimaan</B></FONT>  <FONT COLOR="#E8E8E8" POINT-SIZE="9">kepala transaksi</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_id_penerimaan"><FONT COLOR="#B00020" POINT-SIZE="8"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><B>id_penerimaan</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">INT(11)</FONT></TD><TD ALIGN="LEFT" PORT="R_id_penerimaan"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · AUTO_INCREMENT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_nomor_nota_penerimaan"><FONT COLOR="#6A1B9A" POINT-SIZE="8"><B>UQ</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">nomor_nota_penerimaan</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">CHAR(11)</FONT></TD><TD ALIGN="LEFT" PORT="R_nomor_nota_penerimaan"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · UNIQUE</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_tanggal_terima_penerimaan"><FONT COLOR="#000000" POINT-SIZE="8"><B>&nbsp;&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">tanggal_terima_penerimaan</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">DATE</FONT></TD><TD ALIGN="LEFT" PORT="R_tanggal_terima_penerimaan"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_id_pemasok"><FONT COLOR="#1B5E9B" POINT-SIZE="8"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><I>id_pemasok</I></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">SMALLINT</FONT></TD><TD ALIGN="LEFT" PORT="R_id_pemasok"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · FK → pemasok</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_id_petugas"><FONT COLOR="#1B5E9B" POINT-SIZE="8"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><I>id_petugas</I></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">SMALLINT</FONT></TD><TD ALIGN="LEFT" PORT="R_id_petugas"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · FK → petugas</FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#F3F3F3" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#333333">CK ck_penerimaan_nota: format nomor nota</FONT></TD></TR></TABLE>>];
  detail_penerimaan [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#555555" BGCOLOR="white"><TR><TD COLSPAN="4" BGCOLOR="#B8641E" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="13"><B> detail_penerimaan</B></FONT>  <FONT COLOR="#E8E8E8" POINT-SIZE="9">detail transaksi</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_id_penerimaan"><FONT COLOR="#B00020" POINT-SIZE="8"><B>PK,FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><B>id_penerimaan</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">INT(11)</FONT></TD><TD ALIGN="LEFT" PORT="R_id_penerimaan"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · FK → penerimaan</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_id_buku"><FONT COLOR="#B00020" POINT-SIZE="8"><B>PK,FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><B>id_buku</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">INT(11)</FONT></TD><TD ALIGN="LEFT" PORT="R_id_buku"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL · FK → buku</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="L_jumlah_diterima_detail_penerimaan"><FONT COLOR="#000000" POINT-SIZE="8"><B>&nbsp;&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">jumlah_diterima_detail_penerimaan</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#333333">SMALLINT(6)</FONT></TD><TD ALIGN="LEFT" PORT="R_jumlah_diterima_detail_penerimaan"><FONT POINT-SIZE="8" COLOR="#555555">NOT NULL</FONT></TD></TR><TR><TD COLSPAN="4" BGCOLOR="#F3F3F3" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#333333">CK ck_detail_penerimaan_jumlah: jumlah &gt; 0</FONT></TD></TR></TABLE>>];
  anggota:R_id_anggota:e -> peminjaman:L_id_anggota:w [arrowtail=teetee, arrowhead=crowodot];
